cabal-version: 3.14
name:          miso-indexdb
version:       0.0.1

synopsis:      IndexDB binding
description:
    == Motivation
    #motivation#
    
    IndexDB binding for Miso and Haskell.
    
    === Bare JS
    #bare-js#
    
    An agent generates a decent JS code in case of IndexDB, for example, but
    it is JS… If the project is written Haskell that looks weird.
    
    > function openDatabase() {
    >   return new Promise((resolve, reject) => {
    >     const request = indexedDB.open(DB_NAME, DB_VERSION);
    >     request.onupgradeneeded = () => {
    >       const db = request.result;
    >       if (!db.objectStoreNames.contains(STORE_NAME)) {
    >         db.createObjectStore(STORE_NAME);
    >       }
    >     };
    >     request.onsuccess = () => resolve(request.result);
    >     request.onerror = () => reject(request.error);
    >   });
    > }
    
    === Haskell typed analog
    #haskell-typed-analog#
    
    > import Miso.IndexDb qualified as IDB
    >
    > openDb :: IO IDB.Database
    > openDb = runCbT do
    >   f <- IDB.factory
    >   req <- IDB.open f "blob" (Just 1)
    >   upgraded <- IDB.onUpgradeNeeded upgradeStore req
    >   blocked <- IDB.onBlocked (\_ -> pure ()) upgraded
    >   success <- IDB.onSuccess blocked
    >   done <- IDB.onError success
    >   IDB.result done
    >
    > upgradeStore :: CbM m => IDB.Database -> m ()
    > upgradeStore db = do
    >   storeExists <- IDB.hasObjectStore db "blobs"
    >   unless storeExists do
    >     void $ IDB.createObjectStore db "blobs" (IDB.StoreOptions Nothing True)
    
    == Development environment
    #development-environment#
    
    HLS should be available inside the default dev shell.
    
    > $ nix develop
    > $ cabal build
    
    === In Browser Testing
    #in-browser-testing#
    
    This is a frontend library and the most crucial tests require the
    browser API (IndexDB in particular), which is available only for WASM
    back, which in turn is not first class citizen yet.
    
    > $ nix develop .#wasm
    > $ ./test.sh
homepage:      http://github.com/yaitskov/miso-indexdb
license:       BSD-3-Clause
license-file:  LICENSE
author:        Daniil Iaitskov
maintainer:    dyaitskov@gmail.com
copyright:     Daniil Iaitkov 2026
category:      Miso, Callback, Async
build-type:    Simple
bug-reports:   https://github.com/yaitskov/miso-indexdb/issues
extra-doc-files:
  changelog.md
tested-with:
  GHC == 9.14.1
flag hls-mode
  description: Enable HLS for modules that might be disabled for native arch,
                such as browser dependent test-suit
  default:     False
  manual:      True

source-repository head
  type:
    git
  location:
    https://github.com/yaitskov/miso-indexdb.git

common base
  default-language: GHC2024
  ghc-options: -Wall
  default-extensions:
    BlockArguments
    DefaultSignatures
    NoImplicitPrelude
    OverloadedRecordDot
    OverloadedStrings
    TypeFamilies
  build-depends:
    , base >=4.7 && < 5

library
  import: base
  hs-source-dirs: src
  exposed-modules:
    Miso.IndexDb
    Miso.IndexDb.Cb
    Miso.IndexDb.Cursor
    Miso.IndexDb.Index
    Miso.IndexDb.KeyRange
    Miso.IndexDb.ObjectStore
    Miso.IndexDb.Tx
    UnliftIO.Miso
  other-modules:
    Miso.IndexDb.Internal
    Miso.IndexDb.JsVal
    Miso.IndexDb.Prelude
    Miso.IndexDb.Request
    Miso.IndexDb.List
    Miso.IndexDb.Database
    Miso.IndexDb.Factory
  build-depends:
    , miso               >= 1.15
    , mtl                < 3
    , unliftio           < 1

common test-base
  build-depends:
    base,
    miso,
    miso-indexdb,
    unliftio,
    hspec >= 2.11,
    QuickCheck >= 2.18.0.1,
  default-language: GHC2024
  ghc-options:
    -Wall
  default-extensions:
    BlockArguments
    OverloadedRecordDot
    OverloadedStrings

test-suite test
  import: test-base
  hs-source-dirs: test-no-ffi
  type: exitcode-stdio-1.0
  main-is: hello.hs

test-suite browser
  import: test-base
  if arch(wasm32) || flag(hls-mode)
    buildable: True
  else
    buildable: False

  build-depends:
    ghc-experimental
  hs-source-dirs: test
  other-modules:
    Demo
  type: exitcode-stdio-1.0
  main-is: hello.hs
