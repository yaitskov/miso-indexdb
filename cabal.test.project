-- nix build builds encapsulates all dependencies, but
-- it works only with native GHC backend while
-- the library is supposed to be build for WASM, but it is not sealed
-- only works in dev Shell this cabal contains dependencies for WASM mode
-- when the build is not isolated

packages:
  .

allow-newer:
  all:base

constraints:
  aeson >= 2

source-repository-package
  type: git
  location: https://github.com/dmjio/miso
  tag: 1.15.0
