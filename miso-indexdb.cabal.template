cabal-version: 3.14
name:          miso-indexdb
version:       0.0.1

synopsis:      IndexDB binding
description:
homepage:      http://github.com/yaitskov/miso-indexdb
license:       BSD-3-Clause
license-file:  LICENSE
author:        Daniil Iaitskov
maintainer:    dyaitskov@gmail.com
copyright:     Daniil Iaitkov 2026
category:      Miso, Callback, Async
build-type:    Simple
bug-reports:   https://github.com/yaitskov/miso-indexdb/issues
extra-doc-files:
  changelog.md
tested-with:
  GHC == 9.14.1
flag hls-mode
  description: Enable HLS for modules that might be disabled for native arch,
                such as browser dependent test-suit
  default:     False
  manual:      True

source-repository head
  type:
    git
  location:
    https://github.com/yaitskov/miso-indexdb.git

common base
  default-language: GHC2024
  ghc-options: -Wall
  default-extensions:
    BlockArguments
    DefaultSignatures
    NoImplicitPrelude
    OverloadedRecordDot
    OverloadedStrings
    TypeFamilies
  build-depends:
    , base >=4.7 && < 5

library
  import: base
  hs-source-dirs: src
  exposed-modules:
    Miso.IndexDb
    Miso.IndexDb.Cb
    Miso.IndexDb.Cursor
    Miso.IndexDb.Index
    Miso.IndexDb.KeyRange
    Miso.IndexDb.ObjectStore
    Miso.IndexDb.Tx
    UnliftIO.Miso
  other-modules:
    Miso.IndexDb.Internal
    Miso.IndexDb.JsVal
    Miso.IndexDb.Prelude
    Miso.IndexDb.Request
    Miso.IndexDb.List
    Miso.IndexDb.Database
    Miso.IndexDb.Factory
  build-depends:
    , miso               >= 1.15
    , mtl                < 3
    , unliftio           < 1

common test-base
  build-depends:
    base,
    miso,
    miso-indexdb,
    unliftio,
    hspec >= 2.11,
    QuickCheck >= 2.18.0.1,
  default-language: GHC2024
  ghc-options:
    -Wall
  default-extensions:
    BlockArguments
    OverloadedRecordDot
    OverloadedStrings

test-suite test
  import: test-base
  hs-source-dirs: test-no-ffi
  type: exitcode-stdio-1.0
  main-is: hello.hs

test-suite browser
  import: test-base
  if arch(wasm32) || flag(hls-mode)
    buildable: True
  else
    buildable: False

  build-depends:
    ghc-experimental
  hs-source-dirs: test
  other-modules:
    Demo
  type: exitcode-stdio-1.0
  main-is: hello.hs
